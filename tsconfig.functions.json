{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["cloudbase/functions-src/**/*.ts", "src/data/**/*.ts", "src/services/tripData.ts", "src/services/tripDto.ts", "src/types/**/*.ts", "src/utils/visibility.ts"]
}
